# توكن البوت من Discord Developer Portal
DISCORD_TOKEN=your_bot_token_here

# Client ID للبوت (Application ID)
CLIENT_ID=your_client_id_here

# ID السيرفر (Server / Guild ID)
GUILD_ID=your_guild_id_here

# IDs الأدمن اللي يقدرون يفتحون اللوحة (مفصولة بفاصلة)
ADMIN_IDS=1270262324342816811

# حذف تلقائي للمسجلين إذا ما كانوا داخل أي روم صوتي خلال ساعات معينة
# (اختياري)
ABSENT_HOURS=2
ABSENT_CHECK_INTERVAL_MINUTES=5

# باسورد لوحة التحكم الويب
DASHBOARD_PASSWORD=your_password_here

# منفذ خادم الويب (اختياري - الافتراضي 3000)
WEB_PORT=3000
